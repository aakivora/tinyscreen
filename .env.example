# Copy this file to .env and fill in real values. .env is gitignored.

# emulator (default, for development on your Mac) or hardware (on the Pi
# once rgbmatrix is installed from source).
TINYSCREEN_DISPLAY_BACKEND=emulator

# --- Weather (https://openweathermap.org/api, free "Current Weather" plan) ---
# Leave blank to run with mock/placeholder weather data.
OPENWEATHERMAP_API_KEY=

# Prefer lat/lon (more precise); WEATHER_CITY is used only if lat/lon are blank.
WEATHER_LAT=
WEATHER_LON=
WEATHER_CITY=

# imperial=Fahrenheit, metric=Celsius, standard=Kelvin
# Note: the idle-mode sentence's wind-speed tiers are always in km/h
# regardless of this setting - see _wind_speed_to_kmh in tinyscreen/weather.py.
WEATHER_UNITS=imperial

# --- Idle mode ---
# sentence (default) = the generated weather/mood scrolling sentence below;
# press_to_begin = a static "PRESS <icon> TO BEGIN" screen; road_walk = a
# generative "we make the road by walking" animation (see
# tinyscreen/road_walk.py). None of these poll weather except sentence.
# Spotify mode still takes over automatically either way - this only
# controls what shows when nothing's playing.
# IDLE_MODE=press_to_begin

# horizontal (default) = single line, marquees left; vertical = wraps to
# fill the width, scrolls upward like credits. Only applies to IDLE_MODE=sentence.
# IDLE_LAYOUT=vertical
# SCROLL_SPEED_PX_PER_SEC=20
# FRAME_INTERVAL_SECONDS=0.04

# road_walk idle mode tuning - see tinyscreen/road_walk.py for what each
# one drives. Lower ROAD_WALK_INTERVAL_SECONDS for fast local iteration
# (e.g. 5) when watching it in the emulator.
# ROAD_WALK_INTERVAL_SECONDS=300
# ROAD_WALK_MIN_WALK_SECONDS=4
# ROAD_WALK_SIGNATURE_SECONDS=0.6
# ROAD_WALK_FADE_SECONDS=0.4
# ROAD_WALK_SPEED_PX_PER_SEC=9
# ROAD_WALK_WANDER_AMP_1=0.6
# ROAD_WALK_WANDER_FREQ_1=0.05
# ROAD_WALK_WANDER_AMP_2=0.2
# ROAD_WALK_WANDER_FREQ_2=0.18

# --- Spotify (https://developer.spotify.com/dashboard) ---
# Leave blank to run idle-mode only, no Spotify polling.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
# Must match exactly what's set as a Redirect URI in the Spotify app's
# dashboard settings. Deliberately NOT 8888 - that's already used by
# RGBMatrixEmulator's browser view (see emulator_config.json).
# SPOTIFY_REDIRECT_URI=http://127.0.0.1:8901/callback
# SPOTIFY_POLL_INTERVAL_SECONDS=5
# SPOTIFY_FALLBACK_SECONDS=90
# How often (seconds) the "Track - Artist" ticker scrolls through once;
# for the rest of the cycle it's blank (just album art, no text).
# SPOTIFY_TICKER_CYCLE_SECONDS=60
# How long (seconds) the ticker sits still and readable before a track's
# first scroll, and before each later repeat of the same track.
# SPOTIFY_TICKER_HOLD_SECONDS=0.9
# SPOTIFY_TICKER_REPEAT_HOLD_SECONDS=0.2

# --- Matrix hardware options (defaults match a single 64x64 Adafruit panel) ---
# Uncomment and adjust once real hardware is connected and you're tuning for
# flicker/brightness. See tinyscreen/display.py for what each one does.
# MATRIX_ROWS=64
# MATRIX_COLS=64
# MATRIX_CHAIN_LENGTH=1
# MATRIX_PARALLEL=1
# MATRIX_HARDWARE_MAPPING=adafruit-hat
# MATRIX_BRIGHTNESS=65
# MATRIX_GPIO_SLOWDOWN=2
# MATRIX_PWM_BITS=11
# MATRIX_LIMIT_REFRESH_RATE_HZ=120
# MATRIX_DISABLE_HARDWARE_PULSING=false
